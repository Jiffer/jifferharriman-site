<section class="sec" id="booking">
  <h2>Get in touch</h2>
  <p>{{ bookingIntro or "Interested in bringing this to an event, festival, or venue? Tell me a bit about it." }}</p>
  <form class="form" action="https://formspree.io/f/{{ site.formspreeId }}" method="POST">
    <input type="hidden" name="_subject" value="Inquiry — {{ title }}">
    <input type="hidden" name="source" value="booking:{{ page.fileSlug }}">

    <label class="field"><span>Your name</span>
      <input type="text" name="name" required></label>
    <label class="field"><span>Email</span>
      <input type="email" name="email" required></label>
    <label class="field"><span>What's up?</span>
      <textarea name="message" rows="5" required></textarea></label>

    <button class="btn" type="submit">Send</button>
  </form>
</section>
