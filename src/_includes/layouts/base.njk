<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or tagline or 'Interactive sound installations, musical robots, and instruments anyone can play.' }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=JetBrains+Mono:wght@400;500&family=Public+Sans:wght@400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/css/site.css' | url }}">
</head>
<body>
<div class="shell">
  {% include "partials/nav.njk" %}
  <main class="main">
    <div class="wrap">
{{ content | safe }}
    </div>
  </main>
</div>
<script src="{{ '/js/gallery.js' | url }}"></script>
<script src="{{ '/js/seq.js' | url }}"></script>
</body>
</html>
